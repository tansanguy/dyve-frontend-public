{
  "name": "DYVE",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint src",
    "check:bundle": "node ./scripts/assert-build-budget.mjs",
    "check:connection-organizer": "node ./scripts/check-connection-organizer.mjs",
    "check:group-dive": "node ./scripts/check-group-dive.mjs",
    "check:admin-group-dive": "node ./scripts/check-admin-group-dive.mjs",
    "check:admin-refunds": "node ./scripts/check-admin-refunds.mjs",
    "check:guest-checkout": "node ./scripts/check-guest-checkout.mjs",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run check:bundle",
    "preview": "vite preview",
    "capture:dyve": "node ./scripts/capture-dyve-screenshots.mjs",
    "capture:dyve:assert": "node ./scripts/capture-dyve-screenshots.mjs --assert",
    "preview:smoke": "bash -lc 'pkill -f \"vite preview --host 127.0.0.1 --port 4173\" 2>/dev/null || true; nohup npm run preview -- --host 127.0.0.1 --port 4173 --strictPort > /tmp/preview.log 2>&1 & PREVIEW_PID=$!; sleep 2; curl -m 3 -s -o /dev/null -w \"GET / -> %{http_code}\\\\n\" http://127.0.0.1:4173/; curl -m 3 -s -o /dev/null -w \"GET /chats -> %{http_code}\\\\n\" http://127.0.0.1:4173/chats; curl -m 3 -s -o /dev/null -w \"GET /no-such-path -> %{http_code}\\\\n\" http://127.0.0.1:4173/no-such-path; kill $PREVIEW_PID'"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.487.0",
    "motion": "^12.42.2",
    "react": "^19.2.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.11.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
